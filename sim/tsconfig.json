{
    "compilerOptions": {
        "target": "es2017",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "outFile": "../built/common-sim.js",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2017"
        ],
        "rootDir": "../libs",
        "newLine": "LF",
        "declaration": true,
        "sourceMap": false,
        "types": []
    },
    "files": [
        "../node_modules/pxt-core/built/pxtsim.d.ts",
        "../built/common-simcore.d.ts"
    ],
    "include": [
        "../libs/*/sim/*.ts"
    ],
    "prepend": [
        "../built/common-simcore.js"
    ]
}

